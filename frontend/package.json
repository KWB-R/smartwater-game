{
  "name": "smartwater-frontend",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite --host",
    "dev:pwa": "vite --mode pwadev",
    "dev:pwa:host": "vite --host --mode pwadev",
    "setup:https": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-local-https.ps1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "generate:pwa-icons": "node scripts/generatePwaIcons.mjs",
    "knip": "knip",
    "harness": "pnpm run build && pnpm run lint && pnpm run knip && pnpm run test",
    "unlighthouse": "unlighthouse",
    "unlighthouse:desktop": "unlighthouse --desktop",
    "unlighthouse:core": "node scripts/unlighthouseCoreRoutes.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "pixi.js": "^8.6.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "knip": {
    "entry": [
      "src/main.tsx",
      "src/pwa/sw.ts",
      "unlighthouse.config.ts",
      "scripts/*.mjs"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ],
    "ignore": [
      "src/assets/**",
      "src/types/strapi/**"
    ],
    "ignoreDependencies": [
      "tailwindcss"
    ],
    "ignoreBinaries": [
      "only-allow",
      "powershell"
    ]
  },
  "engines": {
    "node": "^22.13.0 || >=24",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "knip": "^6.29.0",
    "sass": "^1.100.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "unlighthouse": "^0.18.0",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@9.0.0+sha512.b4106707c7225b1748b61595953ccbebff97b54ad05d002aa3635f633b9c53cd666f7ce9b8bc44704f1fa048b9a49b55371ab2d9e9d667d1efe2ef1514bcd513"
}
